<?xml version="1.0" encoding="UTF-16"?>
<!--
  VONO Protection — Scheduled Task template. Placeholders {{STATION_USER}} and {{INSTALL_DIR}} are
  substituted by vono-protection.install.ps1 before Register-ScheduledTask. Absolute paths only.
  Runs the dedicated Node runtime + watchdog.cjs as the station user, interactive, NON-elevated.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>VONO Protection — external watchdog that keeps the branch player (VONO) alive.</Description>
    <URI>\VONO Protection</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>{{STATION_USER}}</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{{STATION_USER}}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{INSTALL_DIR}}\vono-watchdog\node.exe</Command>
      <Arguments>"{{INSTALL_DIR}}\vono-watchdog\watchdog.cjs"</Arguments>
      <WorkingDirectory>{{INSTALL_DIR}}\vono-watchdog</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
