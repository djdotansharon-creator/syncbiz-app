<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0e1a"
    android:fillViewport="true"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#f5f5f7"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <!-- Start on boot -->
        <Switch
            android:id="@+id/switch_start_on_boot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="14dp"
            android:text="@string/setting_start_on_boot"
            android:textColor="#e7edf5"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_start_on_boot_note"
            android:textColor="#8794a6"
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <!-- Auto resume -->
        <Switch
            android:id="@+id/switch_auto_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="14dp"
            android:text="@string/setting_auto_resume"
            android:textColor="#e7edf5"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_auto_resume_note"
            android:textColor="#8794a6"
            android:textSize="13sp"
            android:paddingBottom="24dp" />

        <!-- Audio output -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_output_title"
            android:textColor="#22d3ee"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/text_audio_outputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#e7edf5"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_output_os_note"
            android:textColor="#8794a6"
            android:textSize="13sp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btn_sound_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:layout_marginEnd="16dp"
                android:text="@string/open_sound_settings" />

            <Button
                android:id="@+id/btn_bluetooth_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:text="@string/open_bluetooth_settings" />
        </LinearLayout>

        <!-- Connection status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connection_title"
            android:textColor="#22d3ee"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/text_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#e7edf5"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connection_master_note"
            android:textColor="#8794a6"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp" />

        <!-- Version -->
        <TextView
            android:id="@+id/text_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#697485"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
