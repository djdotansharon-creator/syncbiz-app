<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, no action bar, navy ground. Uses the platform Material theme
         so the shell needs no appcompat/material dependency. -->
    <style name="Theme.VonoStreamer" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#0a0e1a</item>
        <item name="android:statusBarColor">#0a0e1a</item>
        <item name="android:navigationBarColor">#0a0e1a</item>
    </style>
</resources>
